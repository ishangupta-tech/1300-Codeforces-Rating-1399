#include <bits/stdc++.h>
using namespace std;

int main() {
    long long a, b;
    cin >> a >> b;

    int ans = 0;

    while (a % 2 == 0 && b % 2 == 0) {
        a /= 2;
        b /= 2;
    }

    int cntA = 0, cntB = 0;

    while (a % 2 == 0) {
        a /= 2;
        cntA++;
    }

    while (b % 2 == 0) {
        b /= 2;
        cntB++;
    }

    if (a != b) {
        cout << -1;
        return 0;
    }

    ans = abs(cntA - cntB);

    cout << ans;

    return 0;
}
