#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int x;
    cin >> x;

    int mn = x, mx = x;
    int ans = 0;

    for (int i = 1; i < n; i++) {
        cin >> x;

        if (x > mx) {
            mx = x;
            ans++;
        } else if (x < mn) {
            mn = x;
            ans++;
        }
    }

    cout << ans;

    return 0;
}
