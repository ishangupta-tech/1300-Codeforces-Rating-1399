#include <bits/stdc++.h>
using namespace std;

long long removeZero(long long n) {
    long long result = 0;
    long long place = 1;

    while (n > 0) {
        int digit = n % 10;

        if (digit != 0) {
            result += digit * place;
            place *= 10;
        }

        n /= 10;
    }

    return result;
}

int main() {
    long long a, b;
    cin >> a >> b;

    long long c = a + b;

    if (removeZero(a) + removeZero(b) == removeZero(c))
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
