#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<long long> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    long long last = 0;
    int lastQuery = 0;

    while (m--) {
        int type;
        cin >> type;

        if (type == 1) {
            int x;
            long long y;
            cin >> x >> y;

            x--;

            if (lastQuery > 0)
                a[x] = last;
            
            a[x] += y;
        }
        else if (type == 2) {
            long long y;
            cin >> y;

            last = y;
            lastQuery = 1;
        }
        else {
            int x;
            cin >> x;

            x--;

            if (lastQuery > 0)
                cout << last << '\n';
            else
                cout << a[x] << '\n';
        }
    }

    return 0;
}
