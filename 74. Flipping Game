#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int total = 0;

    for (int x : a)
        total += x;

    int best = 0;

    for (int l = 0; l < n; l++) {
        int gain = 0;

        for (int r = l; r < n; r++) {
            if (a[r] == 0)
                gain++;
            else
                gain--;

            best = max(best, gain);
        }
    }

    cout << total + best;

    return 0;
}
