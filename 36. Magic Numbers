#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;

    for (int i = 0; i < s.size();) {
        if (s[i] == '1') {
            i++;
        }
        else if (i + 1 < s.size() && s[i] == '4' && s[i + 1] == '4') {
            i += 2;
        }
        else if (i + 2 < s.size() && s[i] == '1' && s[i + 1] == '4' && s[i + 2] == '4') {
            i += 3;
        }
        else {
            cout << "NO";
            return 0;
        }
    }

    cout << "YES";

    return 0;
}
