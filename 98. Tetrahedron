#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1000000007;

int main() {
    int n;
    cin >> n;

    long long dp[4] = {1, 0, 0, 0};

    for (int i = 0; i < n; i++) {
        long long next[4] = {};

        for (int j = 0; j < 4; j++) {
            for (int k = 0; k < 4; k++) {
                if (j != k) {
                    next[k] = (next[k] + dp[j]) % MOD;
                }
            }
        }

        for (int j = 0; j < 4; j++)
            dp[j] = next[j];
    }

    cout << dp[0];

    return 0;
}
