#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<long long> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    sort(a.begin(), a.end());

    long long difference = a[n - 1] - a[0];

    long long minCount = 0;
    long long maxCount = 0;

    for (long long x : a) {
        if (x == a[0])
            minCount++;

        if (x == a[n - 1])
            maxCount++;
    }

    long long ways;

    if (a[0] == a[n - 1]) {
        ways = 1LL * n * (n - 1) / 2;
    }
    else {
        ways = minCount * maxCount;
    }

    cout << difference << " " << ways;

    return 0;
}
