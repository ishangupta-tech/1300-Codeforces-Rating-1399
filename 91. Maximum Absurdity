#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    vector<long long> a(n);
    for (int i = 0; i < n; i++)
        cin >> a[i];

    vector<long long> sum(n - k + 1, 0);

    for (int i = 0; i < k; i++)
        sum[0] += a[i];

    for (int i = 1; i <= n - k; i++)
        sum[i] = sum[i - 1] - a[i - 1] + a[i + k - 1];

    int first = 0, second = k;
    long long best = sum[first] + sum[second];

    for (int i = 0; i <= n - k; i++) {
        int j = i + k;

        if (j > n - k)
            break;

        if (sum[i] + sum[j] > best) {
            best = sum[i] + sum[j];
            first = i;
            second = j;
        }
    }

    cout << first + 1 << " " << second + 1;

    return 0;
}
