#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<long long> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    if (n <= 2) {
        cout << n;
        return 0;
    }

    int ans = 2;
    int current = 2;

    for (int i = 2; i < n; i++) {
        if (a[i] == a[i - 1] + a[i - 2]) {
            current++;
        } else {
            current = 2;
        }

        ans = max(ans, current);
    }

    cout << ans;

    return 0;
}
