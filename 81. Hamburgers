#include <bits/stdc++.h>
using namespace std;

using ll = long long;

int main() {
    string recipe;
    cin >> recipe;

    ll nb, ns, nc;
    cin >> nb >> ns >> nc;

    ll pb, ps, pc;
    cin >> pb >> ps >> pc;

    ll B = 0, S = 0, C = 0;

    for (char x : recipe) {
        if (x == 'B') B++;
        else if (x == 'S') S++;
        else C++;
    }

    ll money;
    cin >> money;

    ll low = 0;
    ll high = 1e13;

    while (low <= high) {
        ll mid = low + (high - low) / 2;

        ll needB = max(0LL, mid * B - nb);
        ll needS = max(0LL, mid * S - ns);
        ll needC = max(0LL, mid * C - nc);

        ll cost = needB * pb +
                  needS * ps +
                  needC * pc;

        if (cost <= money)
            low = mid + 1;
        else
            high = mid - 1;
    }

    cout << high;

    return 0;
}
