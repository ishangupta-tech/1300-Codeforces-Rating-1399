#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int zero = 0, five = 0;

    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;

        if (x == 5)
            five++;
        else
            zero++;
    }

    if (zero == 0) {
        cout << -1;
        return 0;
    }

    int groups = five / 9;

    if (groups == 0) {
        cout << 0;
        return 0;
    }

    for (int i = 0; i < groups * 9; i++)
        cout << 5;

    for (int i = 0; i < zero; i++)
        cout << 0;

    return 0;
}
