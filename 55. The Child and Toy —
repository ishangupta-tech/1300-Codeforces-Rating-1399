#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<int> cost(n);

    for (int i = 0; i < n; i++)
        cin >> cost[i];

    long long ans = 0;

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;

        u--;
        v--;

        ans += min(cost[u], cost[v]);
    }

    cout << ans;

    return 0;
}
