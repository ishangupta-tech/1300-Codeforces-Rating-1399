#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int h, m;
    cin >> h >> m;

    int current = 1;
    int ans = 1;

    for (int i = 1; i < n; i++) {
        int x, y;
        cin >> x >> y;

        if (x == h && y == m) {
            current++;
        } else {
            current = 1;
        }

        ans = max(ans, current);

        h = x;
        m = y;
    }

    cout << ans;

    return 0;
}
