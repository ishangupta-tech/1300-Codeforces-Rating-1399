#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int l = 1, r = n * n;

    for (int i = 0; i < n; i++) {
        cout << l << " " << r << " ";
        l++;
        r--;

        for (int j = 1; j < n / 2; j++) {
            cout << l << " " << r << " ";
            l++;
            r--;
        }

        cout << '\n';
    }

    return 0;
}
