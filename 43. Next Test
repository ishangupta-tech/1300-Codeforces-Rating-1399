#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    bool present[100005] = {};

    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;
        present[x] = true;
    }

    for (int i = 1; i <= 100000; i++) {
        if (!present[i]) {
            cout << i;
            break;
        }
    }

    return 0;
}
