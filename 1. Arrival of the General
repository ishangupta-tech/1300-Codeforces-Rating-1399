#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[105];
    int mx = 0, mn = 101;
    int mxPos = 0, mnPos = 0;

    for (int i = 0; i < n; i++) {
        cin >> a[i];

        if (a[i] > mx) {
            mx = a[i];
            mxPos = i;
        }

        if (a[i] <= mn) {
            mn = a[i];
            mnPos = i;
        }
    }

    int ans = mxPos + (n - 1 - mnPos);

    if (mxPos > mnPos) {
        ans--;
    }

    cout << ans;

    return 0;
}
