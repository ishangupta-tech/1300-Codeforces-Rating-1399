#include <bits/stdc++.h>
using namespace std;

bool isPrime(int n) {
    if (n < 2)
        return false;

    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0)
            return false;
    }

    return true;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<int>> a(n, vector<int>(m));

    int maxVal = 1000000;

    vector<int> nextPrime(maxVal + 1, 0);

    int last = -1;

    for (int i = maxVal; i >= 0; i--) {
        if (isPrime(i))
            last = i;

        nextPrime[i] = last;
    }

    vector<int> row(n, 0), col(m, 0);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> a[i][j];

            int p = nextPrime[a[i][j]];

            row[i] += p - a[i][j];
            col[j] += p - a[i][j];
        }
    }

    int ans = INT_MAX;

    for (int x : row)
        ans = min(ans, x);

    for (int x : col)
        ans = min(ans, x);

    cout << ans;

    return 0;
}
