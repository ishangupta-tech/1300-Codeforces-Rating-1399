#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<pair<int, int>> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i].first >> a[i].second;

    sort(a.begin(), a.end());

    int last = 0;

    for (int i = 0; i < n; i++) {
        if (a[i].second >= last)
            last = a[i].second;
        else
            last = a[i].first;
    }

    cout << last;

    return 0;
}
