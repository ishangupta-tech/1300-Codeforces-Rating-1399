#include <iostream>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    int x = 0;

    for (int i = 0; i < n; i++) {
        int a;
        cin >> a;

        if (a == 1)
            x++;
    }

    if (x % 2 == 0 && x <= k)
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
