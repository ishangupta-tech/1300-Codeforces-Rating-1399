#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int cnt[8] = {};

    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;
        cnt[x]++;
    }

    if (n % 3 != 0 || cnt[1] != n / 3) {
        cout << -1;
        return 0;
    }

    while (cnt[1] > 0) {
        if (cnt[2] > 0 && cnt[4] > 0) {
            cout << "1 2 4\n";
            cnt[1]--;
            cnt[2]--;
            cnt[4]--;
        }
        else if (cnt[2] > 0 && cnt[6] > 0) {
            cout << "1 2 6\n";
            cnt[1]--;
            cnt[2]--;
            cnt[6]--;
        }
        else if (cnt[3] > 0 && cnt[6] > 0) {
            cout << "1 3 6\n";
            cnt[1]--;
            cnt[3]--;
            cnt[6]--;
        }
        else {
            cout << -1;
            return 0;
        }
    }

    return 0;
}
