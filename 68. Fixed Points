#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int ans = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] == i + 1)
            ans++;
    }

    if (ans >= 2)
        cout << ans;
    else if (ans == 1)
        cout << 1;
    else {
        bool possible = false;

        for (int i = 0; i < n; i++) {
            if (a[a[i] - 1] == i + 1) {
                possible = true;
                break;
            }
        }

        if (possible)
            cout << 2;
        else
            cout << 0;
    }

    return 0;
}
