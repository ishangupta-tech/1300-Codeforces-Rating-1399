#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, v;
    cin >> n >> v;

    vector<int> fruit(3005, 0);

    for (int i = 0; i < n; i++) {
        int day, amount;
        cin >> day >> amount;
        fruit[day] += amount;
    }

    int ans = 0;
    int carry = 0;

    for (int day = 1; day <= 3000; day++) {
        int available = fruit[day] + carry;

        int take = min(v, available);
        ans += take;

        carry = available - take;

        // Fruits can only be carried to the next day.
        if (carry > 0)
            carry = min(carry, v);
    }

    cout << ans;

    return 0;
}
