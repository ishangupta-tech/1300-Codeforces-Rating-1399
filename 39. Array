#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    vector<int> p, ne, z;

    for (int x : a) {
        if (x > 0)
            p.push_back(x);
        else if (x < 0)
            ne.push_back(x);
        else
            z.push_back(x);
    }

    cout << 1 << " " << ne[0] << "\n";

    cout << 1 << " " << p[0] << "\n";

    cout << z.size() + p.size() - 1 << " ";

    for (int x : z)
        cout << x << " ";

    for (int i = 1; i < p.size(); i++)
        cout << p[i] << " ";

    return 0;
}
