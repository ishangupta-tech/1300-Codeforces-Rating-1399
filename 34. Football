#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    map<string, int> mp;
    string team;

    for (int i = 0; i < n; i++) {
        cin >> team;
        mp[team]++;
    }

    string answer;
    int best = 0;

    for (auto x : mp) {
        if (x.second > best) {
            best = x.second;
            answer = x.first;
        }
    }

    cout << answer;

    return 0;
}
