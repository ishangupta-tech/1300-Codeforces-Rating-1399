#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1000000007;

int main() {
    long long x, y, n;
    cin >> x >> y >> n;

    long long a[6];

    a[0] = x;
    a[1] = y;
    a[2] = y - x;
    a[3] = -x;
    a[4] = -y;
    a[5] = x - y;

    cout << (a[(n - 1) % 6] % MOD + MOD) % MOD;

    return 0;
}
