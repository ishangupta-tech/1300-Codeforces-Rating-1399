#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    int ans = -1000000000;

    for (int i = 0; i < n; i++) {
        int f, t;
        cin >> f >> t;

        if (t > k)
            ans = max(ans, f - (t - k));
        else
            ans = max(ans, f);
    }

    cout << ans;

    return 0;
}
