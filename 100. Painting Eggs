#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int diff = 0;
    string ans;

    for (int i = 0; i < n; i++) {
        int a, g;
        cin >> a >> g;

        if (diff + a <= 500) {
            ans += 'A';
            diff += a;
        } else {
            ans += 'G';
            diff -= g;
        }
    }

    cout << ans << '\n';

    return 0;
}
