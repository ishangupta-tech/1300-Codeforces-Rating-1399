#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    cin >> n >> q;

    vector<long long> a(n);
    for (int i = 0; i < n; i++)
        cin >> a[i];

    vector<long long> freq(n + 1, 0);

    while (q--) {
        int l, r;
        cin >> l >> r;

        freq[l - 1]++;
        freq[r]--;
    }

    for (int i = 1; i < n; i++)
        freq[i] += freq[i - 1];

    sort(a.begin(), a.end());
    sort(freq.begin(), freq.end());

    long long ans = 0;

    for (int i = 0; i < n; i++)
        ans += a[i] * freq[i];

    cout << ans;

    return 0;
}
