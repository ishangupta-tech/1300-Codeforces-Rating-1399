#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, s, t;
    cin >> n >> s >> t;

    vector<int> p(n + 1);

    for (int i = 1; i <= n; i++)
        cin >> p[i];

    int current = s;
    int steps = 0;

    while (current != t) {
        current = p[current];
        steps++;

        if (steps > n) {
            cout << -1;
            return 0;
        }
    }

    cout << steps;

    return 0;
}
