#include <bits/stdc++.h>
using namespace std;

int main() {
    string a, b;
    cin >> a >> b;

    if (a.size() != b.size()) {
        cout << "NO";
        return 0;
    }

    vector<int> diff;

    for (int i = 0; i < a.size(); i++) {
        if (a[i] != b[i])
            diff.push_back(i);
    }

    if (diff.size() == 0) {
        cout << "YES";
    }
    else if (diff.size() == 2 &&
             a[diff[0]] == b[diff[1]] &&
             a[diff[1]] == b[diff[0]]) {
        cout << "YES";
    }
    else {
        cout << "NO";
    }

    return 0;
}
