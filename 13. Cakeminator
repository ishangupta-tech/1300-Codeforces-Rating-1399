#include <iostream>
using namespace std;

int main() {
    int r, c;
    cin >> r >> c;

    char a[15][15];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            cin >> a[i][j];

    int ans = 0;

    for (int i = 0; i < r; i++) {
        bool cake = true;

        for (int j = 0; j < c; j++) {
            if (a[i][j] == 'S') {
                cake = false;
                break;
            }
        }

        if (cake) {
            ans += c;
            for (int j = 0; j < c; j++)
                a[i][j] = 'X';
        }
    }

    for (int j = 0; j < c; j++) {
        bool cake = true;

        for (int i = 0; i < r; i++) {
            if (a[i][j] == 'S') {
                cake = false;
                break;
            }
        }

        if (cake) {
            for (int i = 0; i < r; i++) {
                if (a[i][j] != 'X') {
                    ans++;
                    a[i][j] = 'X';
                }
            }
        }
    }

    cout << ans;

    return 0;
}
