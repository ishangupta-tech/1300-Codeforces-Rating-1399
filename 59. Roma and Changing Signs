#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    sort(a.begin(), a.end());

    for (int i = 0; i < n && k > 0; i++) {
        if (a[i] < 0) {
            a[i] = -a[i];
            k--;
        }
    }

    if (k % 2 == 1) {
        int pos = min_element(a.begin(), a.end()) - a.begin();
        a[pos] = -a[pos];
    }

    long long ans = 0;

    for (int x : a)
        ans += x;

    cout << ans;

    return 0;
}
