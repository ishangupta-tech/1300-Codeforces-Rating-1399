#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int inside = 0, ans = 0;

    for (int i = 0; i < n; i++) {
        int a, b;
        cin >> a >> b;

        inside -= a;
        inside += b;

        if (inside > ans)
            ans = inside;
    }

    cout << ans;

    return 0;
}
