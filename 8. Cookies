#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[105];
    int sum = 0;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
    }

    int ans = 0;

    for (int i = 0; i < n; i++) {
        if ((sum - a[i]) % 2 == 0)
            ans++;
    }

    cout << ans;

    return 0;
}
