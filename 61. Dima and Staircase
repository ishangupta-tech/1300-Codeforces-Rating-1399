#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int m;
    cin >> m;

    while (m--) {
        int x, y;
        cin >> x >> y;

        x--;

        a[x] = max(a[x], y);

        cout << a[x] << '\n';
    }

    return 0;
}
