#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<int> color(n + 1, 0);

    while (m--) {
        int a, b, c;
        cin >> a >> b >> c;

        if (color[a] == 0 && color[b] == 0 && color[c] == 0) {
            color[a] = 1;
            color[b] = 2;
            color[c] = 3;
        }
        else {
            if (color[a] != 0) {
                color[b] = (color[a] == 1 ? 2 : 1);
                color[c] = 6 - color[a] - color[b];
            }
            else if (color[b] != 0) {
                color[a] = (color[b] == 1 ? 2 : 1);
                color[c] = 6 - color[a] - color[b];
            }
            else {
                color[a] = (color[c] == 1 ? 2 : 1);
                color[b] = 6 - color[a] - color[c];
            }
        }
    }

    for (int i = 1; i <= n; i++)
        cout << color[i] << " ";

    return 0;
}
