#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<bool> connected(n + 1, false);

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;

        connected[u] = true;
        connected[v] = true;
    }

    int center = -1;

    for (int i = 1; i <= n; i++) {
        if (!connected[i]) {
            center = i;
            break;
        }
    }

    if (center == -1)
        return 0;

    cout << n - 1 << '\n';

    for (int i = 1; i <= n; i++) {
        if (i != center)
            cout << center << " " << i << '\n';
    }

    return 0;
}
